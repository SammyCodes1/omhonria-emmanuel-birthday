rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /wishes/{wishId} {
      allow read: if true;

      // Visitors may add a wish. Name, message, position, and the server time.
      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'position', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.message is string
        && request.resource.data.position in ['Family', 'Friends', 'Church Member', 'Leader']
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.message.size() >= 4
        && request.resource.data.message.size() <= 600
        && request.resource.data.createdAt == request.time;

      allow update: if false;

      // Delete is limited to someone signed in with Firebase Authentication.
      allow delete: if request.auth != null;
    }
  }
}
